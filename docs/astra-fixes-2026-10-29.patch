+/// for loopback servers (local tests and on-device converters).
+pub fn validate_remote_url(value: &str) -> Result<url::Url> {
+    let url = url::Url::parse(value).map_err(|_| anyhow::anyhow!("invalid resource URL"))?;
+    ensure!(
+        matches!(url.scheme(), "http" | "https")
+            && url.host().is_some()
+            && url.username().is_empty()
+            && url.password().is_none(),
+        "resource URL requires HTTP(S) without URL credentials"
+    );
+    let loopback = match url.host() {
+        Some(url::Host::Domain(name)) => name.eq_ignore_ascii_case("localhost"),
+        Some(url::Host::Ipv4(ip)) => ip.is_loopback(),
+        Some(url::Host::Ipv6(ip)) => ip.is_loopback(),
+        None => false,
+    };
+    ensure!(
+        url.scheme() == "https" || loopback,
+        "resource URL must use HTTPS; plain HTTP is only accepted for loopback addresses"
+    );
+    Ok(url)
